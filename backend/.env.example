# Copy to .env and adjust. Every value is optional in development.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Setlist API"
ENVIRONMENT=development          # development | test | production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite is fine for development; use Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/setlist
DATABASE_URL=sqlite:///./social.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma separated list of allowed origins ("*" for local development).
CORS_ORIGINS=*

# ── Music link enrichment ─────────────────────────────────────────────────────
# Looks up title/artwork through the providers' public oEmbed endpoints.
ENABLE_LINK_METADATA=true
LINK_METADATA_TIMEOUT_SECONDS=4
